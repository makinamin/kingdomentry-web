# Static export on Hostinger (LiteSpeed / Apache).
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Folders always end in a slash (matches trailingSlash: true in next.config.ts).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # "/" goes straight to a language on the server, so it never depends on a script:
  # the remembered choice first, then the browser's language, then English.
  RewriteCond %{HTTP_COOKIE} (?:^|;\s*)ke-lang=(en|nl|ar)(?:;|$)
  RewriteRule ^$ /%1/ [R=302,L,E=LANGREDIRECT:1]
  RewriteCond %{HTTP:Accept-Language} ^nl [NC]
  RewriteRule ^$ /nl/ [R=302,L,E=LANGREDIRECT:1]
  RewriteCond %{HTTP:Accept-Language} ^ar [NC]
  RewriteRule ^$ /ar/ [R=302,L,E=LANGREDIRECT:1]
  RewriteRule ^$ /en/ [R=302,L,E=LANGREDIRECT:1]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>

<IfModule mod_headers.c>
  # Hashed build assets never change.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Pages and the page data that menu links load must always be checked for a newer version.
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # The "/" redirect differs per visitor, so no browser or CDN may store it.
  Header always set Cache-Control "private, no-store" env=LANGREDIRECT
  Header always set Vary "Accept-Language, Cookie" env=LANGREDIRECT
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
