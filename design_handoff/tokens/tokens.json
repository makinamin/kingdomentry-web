{
  "color": {
    "blue": "#033CB2",
    "blue-deep": "#022A7D",
    "blue-lift": "#1A52C7",
    "gold": "#B18767",
    "gold-light": "#D2B497",
    "gold-deep": "#86634A",
    "gold-hover": "#C29B7C",
    "pearl": "#F7F7F5",
    "white": "#FFFFFF",
    "stone": "#939598",
    "horizon": "#BFD0F5",
    "ink-soft": "#4A4D57"
  },
  "font": {
    "sans": "'Ubuntu', system-ui, sans-serif",
    "arabic": "'Reem Kufi', sans-serif",
    "weights": [
      300,
      400,
      500,
      700
    ]
  },
  "radius": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "pill": "999px"
  },
  "container": {
    "max": "1200px",
    "gutter": "24px"
  },
  "section": {
    "paddingY": "clamp(64px, 8vw, 112px)",
    "paddingYImmersive": "clamp(72px, 9vw, 128px)"
  },
  "label": {
    "size": "12px",
    "weight": 500,
    "tracking": "0.22em",
    "trackingWide": "0.34em",
    "transform": "uppercase"
  },
  "shadow": {
    "card": "0 24px 60px rgba(3, 60, 178, 0.35)",
    "raised": "0 30px 80px rgba(1, 24, 72, 0.6), inset 0 1px 0 rgba(210, 180, 151, 0.3)",
    "ctaGlow": "0 12px 40px rgba(177, 135, 103, 0.35)"
  },
  "motion": {
    "float": "keFloat 7s ease-in-out infinite",
    "milestone": "keMilestone 8s ease-in-out infinite, stagger 1.2s",
    "reducedMotion": "disable all"
  }
}